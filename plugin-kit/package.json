    "./runtime": "./src/runtime.ts",
    "./host": "./src/host.ts",
    "./ui": "./src/ui.ts",
    "./ui-exports": "./src/ui-exports.ts"
  },
  "bin": {
    "amrita-plugin-build": "./bin/build-plugin.ts"
  },
  "files": ["src", "bin", "README.md"],
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
